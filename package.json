{
  "name": "strategic-alliance-recruit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env npm run build:demo",
    "build:demo": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build --mode demo",
    "build:production": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build --mode production",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "cross-env eslint .",
    "lint:fix": "cross-env eslint . --fix"
  },
  "dependencies": {
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "1.5.0",
    "sass": "1.104.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
