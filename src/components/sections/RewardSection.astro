    title: "数字と品質を両立させるやりがい",
    description:
      "成果だけでなく、業務品質やコンプライアンスの面でも組織を支えます。",
  },
];
---

<section class={styles.containerReward} aria-labelledby="reward-title">
  <div class={styles.inner}>
    <h2 id="reward-title">この仕事のやりがい</h2>
    <ul class={styles.rewardGrid}>
      {
        rewardItems.map((item) => (
          <li class={styles.item}>
